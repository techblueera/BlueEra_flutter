# EditorConfig — https://editorconfig.org
# Primary purpose: force every editor to read/write source files as UTF-8 so
# Unicode characters in comments/strings (— • · │ ─ →) never get re-saved
# through Windows-1252 and turn into mojibake ("â”€", "â€”", "Â·", …).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.dart]
indent_style = space
indent_size = 2
max_line_length = 80

[*.{yaml,yml,json}]
indent_style = space
indent_size = 2

# Markdown: keep trailing whitespace (two spaces = hard line break).
[*.md]
trim_trailing_whitespace = false
