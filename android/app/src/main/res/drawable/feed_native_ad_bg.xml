<?xml version="1.0" encoding="utf-8"?>
<!-- Card background for the feed native ad — white fill, 1dp greyE5 border and
     20dp rounded corners, matching FeedCardWidget. Drawing the rounded corners
     in the native layout (not just via a Flutter clip) keeps all four corners
     crisp — a plain square background bleeds past the rounded clip on platform
     views, which is what made the corners/border look inconsistent. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFF" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="#E5E5E5" />
</shape>
